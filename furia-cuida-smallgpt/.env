# Proveedor recomendado para Codespaces: ollama | demo | hf | openai_compatible
FURIA_PROVIDER=ollama

# Modelo local multilingüe, cuantizado a 4 bits (aprox. 398 MB)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=120
FURIA_CONTEXT_WINDOW=4096

# LatamGPT remoto opcional
LATAMGPT_MODEL=latam-gpt/Llama-3.1-70B-LatamGPT-SFT-1.0
HF_TOKEN=
HF_PROVIDER=featherless-ai

# Endpoint OpenAI-compatible opcional
FURIA_BASE_URL=
FURIA_API_KEY=
FURIA_MODEL=latam-gpt/Llama-3.1-70B-LatamGPT-SFT-1.0

# Límites de generación para consumo reducido
FURIA_MAX_TOKENS=240
FURIA_TEMPERATURE=0.35
