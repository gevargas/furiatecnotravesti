{
  "name": "furIA Cuida · LLM local ligero",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "furIA Cuida",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "bash scripts/setup_codespaces.sh",
  "postStartCommand": "bash scripts/start_ollama.sh",
  "remoteEnv": {
    "FURIA_PROVIDER": "ollama",
    "OLLAMA_MODEL": "qwen2.5:0.5b-instruct-q4_K_M",
    "OLLAMA_NUM_PARALLEL": "1",
    "OLLAMA_MAX_LOADED_MODELS": "1",
    "FURIA_CONTEXT_WINDOW": "4096",
    "FURIA_MAX_TOKENS": "240"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "redhat.vscode-yaml"
      ]
    }
  }
}
