        <rdfs:label>WhatsApp</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/clasismo -->

    <owl:NamedIndividual rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/clasismo">
        <rdf:type rdf:resource="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Problemas"/>
        <rdfs:label>clasismo</rdfs:label>
    </owl:NamedIndividual>
    


