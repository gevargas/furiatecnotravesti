    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/Tia -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/Tia">
        <rdfs:subClassOf rdf:resource="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Comunidad_FuriaTrans"/>
        <rdfs:label>Tía</rdfs:label>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Actividades -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Actividades">
        <rdfs:isDefinedBy>Es la acción o actividad que realizan las personas de la comunidad de trans.</rdfs:isDefinedBy>
        <rdfs:label>Actividades</rdfs:label>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Aptitudes -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Aptitudes">
        <rdfs:comment>Es una capacidad o competencia que tiene una persona  para realizar una actividad específica o un trabajo determinado.</rdfs:comment>
        <rdfs:comment>Este concepto se usará como las características que identifican  a una persona de la comunidad trans.</rdfs:comment>
        <rdfs:label>Aptitudes</rdfs:label>
        <rdfs:seeAlso>Expectativas</rdfs:seeAlso>
        <rdfs:seeAlso>Valores</rdfs:seeAlso>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Comunidad_FuriaTrans -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Comunidad_FuriaTrans">
        <rdfs:subClassOf rdf:resource="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Familias"/>
        <rdfs:label>Comunidad Furia Trans</rdfs:label>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Consanguinea -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Consanguinea">
        <rdfs:subClassOf rdf:resource="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Familias"/>
        <rdfs:label>Familia consanguínea</rdfs:label>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Económicos -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Económicos">
        <rdfs:subClassOf rdf:resource="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Retos"/>
        <rdfs:label>Retos económicos</rdfs:label>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Educativos -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Educativos">
        <rdfs:subClassOf rdf:resource="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Retos"/>
        <rdfs:label>Retos educativos</rdfs:label>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Empleos -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Empleos">
        <rdfs:isDefinedBy>Son las actividades a las que se dedican las personas de la comunidad que les generan alguna remuneración económica.</rdfs:isDefinedBy>
        <rdfs:label>Empleos</rdfs:label>
        <rdfs:seeAlso>Lugares</rdfs:seeAlso>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Expectativas -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Expectativas">
        <rdfs:isDefinedBy>Puede ser una creencia, esperanza o ilusión sobre el futuro o de que algo que deseen suceda.</rdfs:isDefinedBy>
        <rdfs:label>Expectativas</rdfs:label>
        <rdfs:seeAlso>Motivaciones</rdfs:seeAlso>
        <rdfs:seeAlso>Sentimientos</rdfs:seeAlso>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Familias -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Familias">
        <rdfs:comment>Para la comunidad trans hay una clasificación, que es la consanguínea y por el vínculo con la comunidad.</rdfs:comment>
        <rdfs:isDefinedBy>Es el conjunto de personas  ascendientes, descendientes y colaterales, ya sea algún parentesco (de sangre),  por conveniencia, afinidad o adopción</rdfs:isDefinedBy>
        <rdfs:label>Familias</rdfs:label>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Hermana_de_comunidad_Furia -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Hermana_de_comunidad_Furia">
        <rdfs:subClassOf rdf:resource="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Comunidad_FuriaTrans"/>
        <rdfs:isDefinedBy>Una hermana en la comunidad Furia es alguien que te apoya ...</rdfs:isDefinedBy>
        <rdfs:label>Hermana de comunidad furia</rdfs:label>
        <rdfs:seeAlso>Madre</rdfs:seeAlso>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Hija -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Hija">
        <rdfs:subClassOf rdf:resource="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Comunidad_FuriaTrans"/>
        <rdfs:label>Hija</rdfs:label>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Intereses -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Intereses">
        <rdfs:comment></rdfs:comment>
        <rdfs:isDefinedBy>Es la atención, la curiosidad y el deseo de saber o participar más sobre una persona, objeto, tema o actividad.</rdfs:isDefinedBy>
        <rdfs:label>Intereses</rdfs:label>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Legales -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Legales">
        <rdfs:subClassOf rdf:resource="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Retos"/>
        <rdfs:label>Retos legales</rdfs:label>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Lugares -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Lugares">
        <rdfs:comment>Para el contexto de trans, los lugares son los espacios que frecuentan para esparcimiento, trabajo o educación.</rdfs:comment>
        <rdfs:isDefinedBy>Porción de espacio o ubicación concreta que ocupa algo o alguien.</rdfs:isDefinedBy>
        <rdfs:label>Lugares</rdfs:label>
        <rdfs:seeAlso>Empleos</rdfs:seeAlso>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Madre -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Madre">
        <rdfs:subClassOf rdf:resource="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Comunidad_FuriaTrans"/>
        <rdfs:label>Madre</rdfs:label>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Motivaciones -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Motivaciones">
        <rdfs:isDefinedBy>Es un estado de ánimo que hace que una persona se active para conseguir las metas concretas que se haya propuesto.</rdfs:isDefinedBy>
        <rdfs:label>Motivaciones</rdfs:label>
        <rdfs:seeAlso>Expectativas</rdfs:seeAlso>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Médicos -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Médicos">
        <rdfs:subClassOf rdf:resource="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Retos"/>
        <rdfs:label>Retos médicos</rdfs:label>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Ofensas_hacia_las_cuerpas_trans -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Ofensas_hacia_las_cuerpas_trans">
        <rdfs:comment></rdfs:comment>
        <rdfs:comment>Frases que son reciben las personas de la comunidad trans.</rdfs:comment>
        <rdfs:isDefinedBy>Es una acción, palabra o acto que hiere, daña o humilla la dignidad, el honor, la sensibilidad o el respeto hacia una persona.</rdfs:isDefinedBy>
        <rdfs:label>Ofensas hacia las cuerpas trans</rdfs:label>
        <rdfs:seeAlso>Piropos</rdfs:seeAlso>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Organizaciones -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Organizaciones">
        <rdfs:comment>Organizaciones como colectivos y asociaciones en defensa de la comunidad trans.</rdfs:comment>
        <rdfs:isDefinedBy>Asociación de personas regulada por un conjunto de normas en función de determinados fines.</rdfs:isDefinedBy>
        <rdfs:label>Organizaciones</rdfs:label>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Personas -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Personas">
        <rdfs:comment>Ente capaz de tener facultades y deberes.</rdfs:comment>
        <rdfs:label>Personas</rdfs:label>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Piropos -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Piropos">
        <rdfs:comment>frases que escucha la comunidad trans de otras personas de la comunidad o externos.</rdfs:comment>
        <rdfs:isDefinedBy>Frase breve y halagadora con la que se elogia o pondera alguna cualidad de una persona, especialmente su belleza.</rdfs:isDefinedBy>
        <rdfs:label>Piropos</rdfs:label>
        <rdfs:seeAlso>Ofensas</rdfs:seeAlso>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Problemas -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Problemas">
        <rdfs:isDefinedBy>obstáculo, dificultad o una cuestión que surge y exige una solución o una aclaración, así como también tiene consecuencias económicas o de salud.</rdfs:isDefinedBy>
        <rdfs:label>Problemas</rdfs:label>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Retos -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Retos">
        <rdfs:isDefinedBy>Objetivo o empeño difícil de llevar a cabo, y que constituye por ello un estímulo y un desafío para quien lo afronta.</rdfs:isDefinedBy>
        <rdfs:label>Retos</rdfs:label>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Sentimientos -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Sentimientos">
        <rdfs:isDefinedBy>Estado de ánimo como también a una emoción conceptualizada que determina el estado de ánimo de una persona.</rdfs:isDefinedBy>
        <rdfs:label>Sentimientos</rdfs:label>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Sociales -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Sociales">
        <rdfs:subClassOf rdf:resource="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Retos"/>
        <rdfs:label>Retos sociales</rdfs:label>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Tecnologías -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Tecnologías">
        <rdfs:comment>Tecnologías que son utilizadas entre la comunidad trans.</rdfs:comment>
        <rdfs:isDefinedBy>Es la suma de técnicas, habilidades, métodos y procesos utilizados en la producción de bienes o servicios o en el logro de objetivos.</rdfs:isDefinedBy>
        <rdfs:label>Tecnologías</rdfs:label>
    </owl:Class>
    


    <!-- https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Valores -->

    <owl:Class rdf:about="https://furiatecnologiatravesti.org/ontologiaFuriaTrans/#Valores">
        <rdfs:isDefinedBy>Son creencias individuales que motivan a las personas a comportarse de una manera u otra.</rdfs:isDefinedBy>
        <rdfs:label>Valores</rdfs:label>
        <rdfs:seeAlso>Aptitudes</rdfs:seeAlso>
    </owl:Class>
    


