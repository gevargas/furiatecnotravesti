# ------------------------------------------------------------
# furIA Cuida — configuración del proveedor
# ------------------------------------------------------------

# Opciones: demo | hf | openai_compatible
FURIA_PROVIDER=demo

# Modelo oficial LatamGPT 1.0
LATAMGPT_MODEL=latam-gpt/Llama-3.1-70B-LatamGPT-SFT-1.0

# ---------- Opción A: Hugging Face Inference Provider ----------
# Un token de Hugging Face. No lo subas al repositorio.
HF_TOKEN=
# El proveedor puede cambiar según disponibilidad del modelo.
# Si el modelo no está servido por el proveedor elegido, usa un endpoint dedicado.
HF_PROVIDER=featherless-ai

# ---------- Opción B: Endpoint OpenAI-compatible ----------
# Ejemplos: un endpoint HF dedicado con vLLM, un servidor vLLM propio,
# SGLang, u otro servicio que exponga /v1/chat/completions.
FURIA_BASE_URL=
FURIA_API_KEY=
FURIA_MODEL=latam-gpt/Llama-3.1-70B-LatamGPT-SFT-1.0

# Límites de generación
FURIA_MAX_TOKENS=500
FURIA_TEMPERATURE=0.35
